PORT=5001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/clinic_booking?schema=public"

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# AI — gợi ý chuyên khoa từ triệu chứng. Lấy key miễn phí tại https://aistudio.google.com/apikey
# Bỏ trống: tính năng trả lỗi 503 rõ ràng, các API khác vẫn hoạt động bình thường.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
